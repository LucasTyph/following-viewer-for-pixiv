{
  "manifest_version": 3,
  "name": "Following Viewer for Pixiv",
  "version": "1.3.2",
  "description": "Step through new works from the Pixiv artists you follow, in date order, one click at a time.",
  "browser_specific_settings": {
    "gecko": {
      "id": "{8d14099d-1d06-4aed-a683-8c7b30ffe07d}",
      "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["websiteActivity"] }
    }
  },
  "permissions": ["storage"],
  "icons": { "48": "icons/icon.svg", "96": "icons/icon.svg" },
  "action": {
    "default_title": "Open Following Viewer",
    "default_icon": "icons/icon.svg"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+P" },
      "description": "Open the viewer"
    }
  },
  "background": { "scripts": ["background.js"] },
  "content_scripts": [
    {
      "matches": ["https://www.pixiv.net/*"],
      "js": ["src/timeline.js", "src/api.js", "src/ugoira.js", "src/reactions.js", "src/styles.js", "src/viewer.js", "src/main.js"],
      "run_at": "document_start"
    }
  ]
}
